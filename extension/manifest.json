{
  "manifest_version": 3,
  "name": "xmd: copy Markdown link",
  "version": "0.3.1",
  "description": "Copy an xmd.imfrank.dev link for the current tab.",
  "permissions": ["activeTab", "clipboardWrite"],
  "action": {
    "default_title": "Copy xmd link",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
